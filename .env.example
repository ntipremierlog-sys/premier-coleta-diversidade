# Para desenvolvimento local com SQLite:
DATABASE_URL="file:./dev.db"

# Para produção com PostgreSQL (ex: Supabase, Neon, RDS):
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# Perfil 1: rh_agregado (apenas estatísticas e Extrato consolidado)
ADMIN_PASSWORD="troque-para-senha-segura-aqui"

# Perfil 2: rh_administrador (acesso individual, auditoria, exportação nominal e direitos do titular)
ADMIN_MASTER_PASSWORD="troque-para-senha-master-segura-aqui"

# Tokens de sessão para cookies autenticados do painel admin
# Gere valores longos e aleatórios (ex: openssl rand -hex 32)
# NUNCA reutilize os mesmos valores entre desenvolvimento e produção
SESSION_SECRET_AGREGADO="gere-um-token-aleatorio-longo-aqui"
SESSION_SECRET_MASTER="gere-um-token-aleatorio-diferente-aqui"

# Chave secreta para hash determinístico de CPF (HMAC-SHA256) - NUNCA expor em repositórios públicos
CPF_HASH_SECRET="chave_secreta_segura_para_hash_de_cpf_premier"

# Prazo de retenção de dados cadastrais identificáveis (em meses) - A validar com Jurídico/DPO
DATA_RETENTION_MONTHS=24

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
